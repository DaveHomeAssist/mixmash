{
  "version": 2,
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "www.mixmash.games" }],
      "destination": "https://mixmash.games/:path*",
      "permanent": true
    }
  ],
  "functions": {
    "api/[...path].mjs": {
      "maxDuration": 10
    },
    "api/health.mjs": {
      "maxDuration": 10
    },
    "api/sessions.mjs": {
      "maxDuration": 10
    },
    "api/sessions/[sessionId].mjs": {
      "maxDuration": 10
    },
    "api/sessions/[sessionId]/commands.mjs": {
      "maxDuration": 10
    }
  }
}
